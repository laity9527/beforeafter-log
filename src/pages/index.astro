---
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/format-date';

const logs = (await getCollection('log')).sort(
	(a, b) => b.data.before_written_at.getTime() - a.data.before_written_at.getTime()
);

const ledgers = await getCollection('seal');
const sealedCount = logs.filter((log) =>
	ledgers.some((ledger) => ledger.data.slug === log.id && ledger.data.seals.length > 0)
).length;
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>前后志 | Laity Studio</title>
		<style>
			/* 基础与排版 */
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				background-color: #050505;
				color: #e5e5e5;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				line-height: 1.6;
				padding: 0 1.5rem;
			}
			.container { max-width: 60ch; margin: 0 auto; padding: 5rem 0; }
			
			/* 极简导航 */
			nav {
				display: flex; justify-content: space-between; align-items: center;
				font-size: 0.85rem; margin-bottom: 6rem; font-family: monospace;
			}
			nav a { color: #737373; text-decoration: none; transition: color 0.2s; }
			nav a:hover { color: #fbbf24; }

			/* Hero 区 */
			header { margin-bottom: 5rem; }
			h1 { font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; color: #fafafa; }
			.subtitle { font-size: 1.1rem; color: #a3a3a3; margin-bottom: 1.5rem; line-height: 1.5; }
			
			/* Git 存证徽章 */
			.trust-badge {
				display: inline-flex; align-items: center; gap: 0.5rem;
				font-size: 0.75rem; color: #10b981; background-color: rgba(16, 185, 129, 0.08);
				padding: 0.3rem 0.75rem; border-radius: 2rem; border: 1px solid rgba(16, 185, 129, 0.2);
				font-family: monospace;
			}
			.trust-badge svg { width: 14px; height: 14px; }
			.trust-badge.pending {
				color: #fbbf24; background-color: rgba(251, 191, 36, 0.08);
				border-color: rgba(251, 191, 36, 0.2);
			}

			/* 区块标题 */
			.section-title {
				font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;
				color: #525252; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;
			}
			.section-title::after { content: ""; flex: 1; height: 1px; background-color: #262626; }

			/* 作品卡片 */
			.work-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 4rem; }
			.work-card {
				display: block; text-decoration: none; color: inherit; background-color: #121212;
				border: 1px solid #262626; border-radius: 0.5rem; padding: 1.25rem;
				transition: all 0.2s ease;
			}
			.work-card:hover { border-color: #404040; background-color: #171717; transform: translateX(2px); }
			
			.work-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; }
			.work-desc { color: #a3a3a3; font-size: 0.9rem; }
			
			/* 呼吸灯状态 */
			.status { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-family: monospace; color: #a3a3a3; }
			.dot { width: 6px; height: 6px; border-radius: 50%; }
			.dot-live { background-color: #10b981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.6); }
			.dot-wip { background-color: #fbbf24; box-shadow: 0 0 8px rgba(251, 191, 36, 0.6); }

			/* 日志列表 (极客终端风格) */
			.log-list { display: flex; flex-direction: column; gap: 2rem; }
			.log-item {
				display: block; text-decoration: none; color: inherit;
				border-left: 1px solid #262626; padding-left: 1.5rem; position: relative;
				transition: border-color 0.2s;
			}
			.log-item::before {
				content: ""; position: absolute; left: -4px; top: 0.4rem;
				width: 7px; height: 7px; border-radius: 50%; background-color: #404040;
				transition: background-color 0.2s;
			}
			.log-item:hover { border-color: #525252; }
			.log-item:hover::before { background-color: #fbbf24; }
			.log-item:hover .log-title { color: #fbbf24; }

			/* 时间戳 Meta */
			.log-meta { 
				display: flex; align-items: center; gap: 0.75rem; 
				font-size: 0.75rem; color: #737373; margin-bottom: 0.6rem; font-family: monospace; 
			}
			.log-meta .date { color: #a3a3a3; }
			.log-meta .arrow { color: #525252; }
			
			/* 标题与标签 */
			.log-title { font-size: 1.15rem; font-weight: 500; margin-bottom: 0.6rem; color: #e5e5e5; transition: color 0.2s; }
			.log-tags { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
			.log-tag { 
				font-size: 0.7rem; color: #a3a3a3; background-color: #171717; 
				border: 1px solid #262626; padding: 0.1rem 0.4rem; border-radius: 0.25rem; font-family: monospace;
			}

			/* 判断摘要 */
			.log-lesson { 
				font-size: 0.85rem; color: #737373; line-height: 1.5; 
				font-style: italic; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
			}

			/* 页脚 */
			footer { margin-top: 6rem; text-align: center; font-size: 0.75rem; color: #525252; font-family: monospace; }
		</style>
	</head>
	<body>
		<div class="container">
			
			<!-- 导航 -->
			<nav>
				<a href="https://laity.work">← 返回 Laity</a>
				<a href="/about">关于方法论 ↗</a>
			</nav>

			<!-- Hero -->
			<header>
				<h1>前后志</h1>
				<p class="subtitle">不囤想法，直接上线。<br>每个作品，都有做之前和做之后。</p>
				<span class:list={['trust-badge', { pending: sealedCount < logs.length }]}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>
					Git 存证 {sealedCount}/{logs.length} 条已封存
				</span>
			</header>

			<!-- 作品区 -->
			<section>
				<h2 class="section-title">运行中的矩阵</h2>
				<div class="work-grid">
					
					<a href="https://laity.work" class="work-card" target="_blank">
						<div class="work-title">
							<span>Laity Hub 主站</span>
							<div class="status"><span class="dot dot-live"></span> LIVE</div>
						</div>
						<p class="work-desc">聚合所有项目矩阵的个人公司大厅。</p>
					</a>

					<div class="work-card" style="opacity: 0.5; cursor: not-allowed; border-style: dashed;">
						<div class="work-title">
							<span>地球 Online 镜像版</span>
							<div class="status"><span class="dot dot-wip"></span> WIP</div>
						</div>
						<p class="work-desc">真人镜像系统。正在构建中...</p>
					</div>

				</div>
			</section>

			<!-- 日志区 -->
			<section>
				<h2 class="section-title">判断轨迹</h2>
				
				<div class="log-list">
					{logs.map((log) => (
						<a href={`/log/${log.data.work_slug}`} class="log-item">
							<div class="log-meta">
								<span class="date">{formatDate(log.data.before_written_at)}</span>
								<span class="arrow">→</span>
								<span>{log.data.after_written_at ? formatDate(log.data.after_written_at) : '待验证'}</span>
							</div>
							<h3 class="log-title">{log.data.title}</h3>
							{log.data.tags.length > 0 && (
								<div class="log-tags">
									{log.data.tags.map((tag) => <span class="log-tag">{tag}</span>)}
								</div>
							)}
							{log.data.lesson_learned && <p class="log-lesson">{log.data.lesson_learned}</p>}
						</a>
					))}
				</div>

			</section>

			<!-- 页脚 -->
			<footer>
				<p>Laity Studio © 2026. All judgments are timestamped.</p>
			</footer>

		</div>
	</body>
</html>