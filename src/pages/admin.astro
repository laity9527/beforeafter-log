<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>发布后台 | 前后志</title>
		<style>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				background-color: #050505;
				color: #e5e5e5;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				line-height: 1.6;
				padding: 0 1.5rem;
			}
			.container { max-width: 62ch; margin: 0 auto; padding: 5rem 0; }

			nav {
				display: flex; justify-content: space-between; align-items: center;
				font-size: 0.85rem; margin-bottom: 3.5rem; font-family: monospace;
			}
			nav a { color: #737373; text-decoration: none; transition: color 0.2s; }
			nav a:hover { color: #fbbf24; }

			h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: #fafafa; }
			.hint { font-size: 0.9rem; color: #737373; margin-bottom: 3rem; }

			form { display: flex; flex-direction: column; gap: 1.5rem; }
			label {
				display: flex; flex-direction: column; gap: 0.4rem;
				font-family: monospace; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;
				color: #a3a3a3;
			}
			label span { color: #525252; text-transform: none; letter-spacing: 0; font-size: 0.7rem; }
			input, textarea {
				background-color: #0a0a0a; border: 1px solid #262626; border-radius: 0.4rem;
				color: #e5e5e5; font-family: inherit; font-size: 0.95rem; padding: 0.7rem 0.85rem;
				transition: border-color 0.2s; width: 100%;
			}
			textarea { font-family: monospace; font-size: 0.85rem; line-height: 1.6; resize: vertical; }
			input:focus, textarea:focus { outline: none; border-color: #fbbf24; }
			input::placeholder, textarea::placeholder { color: #404040; }

			button {
				align-self: flex-start; background-color: #121212; border: 1px solid #262626; border-radius: 0.4rem;
				color: #e5e5e5; font-family: monospace; font-size: 0.85rem; padding: 0.75rem 1.5rem;
				cursor: pointer; transition: all 0.2s;
			}
			button:hover:not(:disabled) { border-color: #fbbf24; color: #fbbf24; }
			button:disabled { cursor: progress; opacity: 0.55; }

			.status { font-family: monospace; font-size: 0.8rem; min-height: 1.4rem; }
			.status[data-kind='pending'] { color: #a3a3a3; }
			.status[data-kind='ok'] { color: #10b981; }
			.status[data-kind='error'] { color: #f87171; }
		</style>
	</head>
	<body>
		<div class="container">
			<nav>
				<a href="/">← 返回判断轨迹</a>
				<a href="https://github.com/laity9527/beforeafter-log" target="_blank" rel="noopener noreferrer">仓库 ↗</a>
			</nav>

			<h1>发布后台</h1>
			<p class="hint">写一条判断记录：BEFORE 先上线，AFTER 留空等验证之后再补。密码只发给服务端校验，本页不做任何判断。</p>

			<form id="publish-form">
				<label>
					Admin Password
					<input type="password" name="password" autocomplete="off" required />
				</label>

				<label>
					标题
					<input type="text" name="title" placeholder="我为什么把“平台想法”改成了“判断轨迹站”" required />
				</label>

				<label>
					作品标识 work_slug
					<input type="text" name="work_slug" placeholder="why-this-site" pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
						title="小写字母、数字与短横线，不以短横线开头或结尾；它同时是文件名与详情页地址，定了不要改" required />
					<span>同时是 src/content/logs/&lt;work_slug&gt;.md 的文件名，定了不要改</span>
				</label>

				<label>
					标签（逗号分隔）
					<input type="text" name="tags" placeholder="需求判断, AI协作" />
				</label>

				<label>
					BEFORE 文本
					<textarea name="before" rows="9" placeholder="当时的判断 / 明确不做什么" required></textarea>
				</label>

				<label>
					AFTER 文本
					<textarea name="after" rows="9" placeholder="留空即为待验证，上线后回来补"></textarea>
				</label>

				<button type="submit" id="submit-btn">发布</button>
				<p class="status" id="status" role="status" aria-live="polite"></p>
			</form>
		</div>

		<script>
			const form = document.getElementById('publish-form');
			const submitBtn = document.getElementById('submit-btn');
			const statusEl = document.getElementById('status');

			const setStatus = (text, kind) => {
				statusEl.textContent = text;
				statusEl.dataset.kind = kind;
			};

			const buildPayload = (data) => ({
				password: String(data.get('password') ?? ''),
				title: String(data.get('title') ?? '').trim(),
				work_slug: String(data.get('work_slug') ?? '').trim(),
				tags: String(data.get('tags') ?? '')
					.split(/[,，]/)
					.map((tag) => tag.trim())
					.filter(Boolean),
				before: String(data.get('before') ?? '').trim(),
				after: String(data.get('after') ?? '').trim() || null,
			});

			const describeFailure = async (response) => {
				const details = [];
				let serverError = null;
				try {
					const data = await response.json();
					if (typeof data?.error === 'string') serverError = data.error;
					if (typeof data?.detail === 'string' && data.detail) details.push(data.detail);
				} catch {
					// 网关或静态托管回的不一定是 JSON，落到下面的状态码文案
				}
				if (serverError) return details.length > 0 ? `${serverError} · ${details.join(' · ')}` : serverError;
				if (response.status === 404 || response.status === 405) {
					return `接口未部署或路径不通（${response.status}），内容未写入仓库`;
				}
				return `${response.status}${response.statusText ? ` ${response.statusText}` : ''}`;
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const payload = buildPayload(new FormData(form));

				const idleLabel = submitBtn.textContent;
				submitBtn.disabled = true;
				submitBtn.setAttribute('aria-busy', 'true');
				submitBtn.textContent = '发布中…';
				setStatus('正在提交…', 'pending');

				try {
					const response = await fetch('/api/publish', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload),
					});

					if (response.ok) {
						form.reset();
						setStatus('发布成功，等待构建', 'ok');
					} else {
						setStatus(`发布失败：${await describeFailure(response)}`, 'error');
					}
				} catch (error) {
					setStatus(`发布失败：请求没有发出去（${error.message}）`, 'error');
				} finally {
					submitBtn.disabled = false;
					submitBtn.removeAttribute('aria-busy');
					submitBtn.textContent = idleLabel;
				}
			});
		</script>
	</body>
</html>
