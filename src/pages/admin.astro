<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>发布后台 | 前后志</title>
		<style>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				background-color: #050505;
				color: #e5e5e5;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				line-height: 1.6;
				padding: 0 1.5rem;
			}
			.container { max-width: 62ch; margin: 0 auto; padding: 5rem 0; }

			nav {
				display: flex; justify-content: space-between; align-items: center;
				font-size: 0.85rem; margin-bottom: 3.5rem; font-family: monospace;
			}
			nav a { color: #737373; text-decoration: none; transition: color 0.2s; }
			nav a:hover { color: #fbbf24; }

			h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: #fafafa; }
			.hint { font-size: 0.9rem; color: #737373; margin-bottom: 3rem; }

			form { display: flex; flex-direction: column; gap: 1.5rem; }
			label {
				display: flex; flex-direction: column; gap: 0.4rem;
				font-family: monospace; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;
				color: #a3a3a3;
			}
			label span { color: #525252; text-transform: none; letter-spacing: 0; font-size: 0.7rem; }
			input, textarea {
				background-color: #0a0a0a; border: 1px solid #262626; border-radius: 0.4rem;
				color: #e5e5e5; font-family: inherit; font-size: 0.95rem; padding: 0.7rem 0.85rem;
				transition: border-color 0.2s; width: 100%;
			}
			textarea { font-family: monospace; font-size: 0.85rem; line-height: 1.6; resize: vertical; }
			input:focus, textarea:focus { outline: none; border-color: #fbbf24; }
			input::placeholder, textarea::placeholder { color: #404040; }

			button {
				align-self: flex-start; background-color: #121212; border: 1px solid #262626; border-radius: 0.4rem;
				color: #e5e5e5; font-family: monospace; font-size: 0.85rem; padding: 0.75rem 1.5rem;
				cursor: pointer; transition: all 0.2s;
			}
			button:hover:not(:disabled) { border-color: #fbbf24; color: #fbbf24; }
			button:disabled { cursor: progress; opacity: 0.55; }

			.status { font-family: monospace; font-size: 0.8rem; min-height: 1.4rem; }
			.status[data-kind='pending'] { color: #a3a3a3; }
			.status[data-kind='ok'] { color: #10b981; }
			.status[data-kind='error'] { color: #f87171; }

			/* AI 解析区：故意放在 form 外面，否则 form.reset() 会连 Commit Hash 一起清掉，
			   而且它的 pattern 会参与整表校验，哈希没填对时连发布都会被拦住 */
			.ai {
				border: 1px dashed #262626; border-radius: 0.5rem; padding: 1.25rem;
				margin-bottom: 2.5rem; background-color: #0a0a0a;
			}
			.spinner {
				display: none; width: 12px; height: 12px; margin-right: 0.5rem;
				border: 2px solid #262626; border-top-color: #fbbf24; border-radius: 50%;
				vertical-align: -1px;
			}
			#analyze-btn[data-busy='true'] .spinner { display: inline-block; animation: spin 0.8s linear infinite; }
			@keyframes spin { to { transform: rotate(360deg); } }
			@media (prefers-reduced-motion: reduce) {
				#analyze-btn[data-busy='true'] .spinner { animation: none; border-top-color: #a3a3a3; }
			}
		</style>
	</head>
	<body>
		<div class="container">
			<nav>
				<a href="/">← 返回判断轨迹</a>
				<a href="https://github.com/laity9527/beforeafter-log" target="_blank" rel="noopener noreferrer">仓库 ↗</a>
			</nav>

			<h1>发布后台</h1>
			<p class="hint">写一条判断记录：BEFORE 先上线，AFTER 留空等验证之后再补。密码只发给服务端校验，本页不做任何判断。</p>

			<div class="ai">
				<label>
					Commit Hash
					<input type="text" id="commit-hash" placeholder="a4ddaa4 或 7-40 位完整 sha" autocomplete="off" spellcheck="false" />
					<span>只分析这一个仓库的提交：laity9527/beforeafter-log（服务端锁死，传别的 repo 会被拒）</span>
				</label>
				<button type="button" id="analyze-btn">
					<span class="spinner" aria-hidden="true"></span>AI 解析代码变更
				</button>
				<p class="status" id="analyze-status" role="status" aria-live="polite"></p>
			</div>

			<form id="publish-form">
				<label>
					Admin Password
					<input type="password" name="password" autocomplete="off" required />
				</label>

				<label>
					标题
					<input type="text" name="title" placeholder="我为什么把“平台想法”改成了“判断轨迹站”" required />
				</label>

				<label>
					作品标识 work_slug
					<input type="text" name="work_slug" placeholder="why-this-site" pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
						title="小写字母、数字与短横线，不以短横线开头或结尾；它同时是文件名与详情页地址，定了不要改" required />
					<span>同时是 src/content/logs/&lt;work_slug&gt;.md 的文件名，定了不要改</span>
				</label>

				<label>
					标签（逗号分隔）
					<input type="text" name="tags" placeholder="需求判断, AI协作" />
				</label>

				<label>
					BEFORE 文本
					<textarea name="before" rows="9" placeholder="当时的判断 / 明确不做什么" required></textarea>
				</label>

				<label>
					AFTER 文本
					<textarea name="after" rows="9" placeholder="留空即为待验证，上线后回来补"></textarea>
				</label>

				<button type="submit" id="submit-btn">发布</button>
				<p class="status" id="status" role="status" aria-live="polite"></p>
			</form>
		</div>

		<script>
			import { isSuccessfulResponse, readApiResponse } from '../utils/api-result';

			const form = document.getElementById('publish-form');
			const submitBtn = document.getElementById('submit-btn');
			const statusEl = document.getElementById('status');
			const analyzeBtn = document.getElementById('analyze-btn');
			const analyzeStatusEl = document.getElementById('analyze-status');
			const hashInput = document.getElementById('commit-hash');

			const writeStatus = (target, text, kind) => {
				target.textContent = text;
				target.dataset.kind = kind;
			};
			const setStatus = (text, kind) => writeStatus(statusEl, text, kind);
			const setAnalyzeStatus = (text, kind) => writeStatus(analyzeStatusEl, text, kind);

			// 后端把 AI 产的 BEFORE 一律换成这句占位；这里只当第二道锁，主锁是 beforeUntouched 标志
			const AI_PLACEHOLDER = '（此段由本人在动手之前手写：当时怎么判断、明确不做什么。AI 不代写预判。）';
			let beforeUntouched = false;
			form.elements.before.addEventListener('input', () => {
				beforeUntouched = false;
			});

			const buildPayload = (data) => ({
				password: String(data.get('password') ?? ''),
				title: String(data.get('title') ?? '').trim(),
				work_slug: String(data.get('work_slug') ?? '').trim(),
				tags: String(data.get('tags') ?? '')
					.split(/[,，]/)
					.map((tag) => tag.trim())
					.filter(Boolean),
				before: String(data.get('before') ?? '').trim(),
				after: String(data.get('after') ?? '').trim() || null,
			});

			const describeFailure = (response, payload, note) => {
				const details = [];
				if (typeof payload?.detail === 'string' && payload.detail) details.push(payload.detail);
				const serverError = typeof payload?.error === 'string' ? payload.error : null;
				const tail = note ? `，${note}` : '';
				const cfRay = response.headers.get('cf-ray');
				const trace = cfRay ? ` · CF-Ray ${cfRay}` : '';
				if (serverError) return details.length > 0 ? `${serverError} · ${details.join(' · ')}` : serverError;
				// 拿不到 JSON = 请求没进到我们的 Function，多半被静态托管兜底成了 200 的首页壳
				if (!payload) return `接口没有接管这个请求（HTTP ${response.status} 回的不是 JSON）${tail}${trace}`;
				if (response.status === 404 || response.status === 405) {
					return `接口未部署或路径不通（${response.status}）${tail}${trace}`;
				}
				return `HTTP ${response.status}${response.statusText ? ` ${response.statusText}` : ''}${tail}${trace}`;
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const payload = buildPayload(new FormData(form));

				if (beforeUntouched || payload.before === AI_PLACEHOLDER) {
					setStatus('BEFORE 还是 AI 占位，这句不能当判断发布——本人写完后重试', 'error');
					return;
				}

				const idleLabel = submitBtn.textContent;
				submitBtn.disabled = true;
				submitBtn.setAttribute('aria-busy', 'true');
				submitBtn.textContent = '发布中…';
				setStatus('正在提交…', 'pending');

				try {
					const response = await fetch('/api/publish', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload),
					});

					const { payload } = await readApiResponse(response);
					if (isSuccessfulResponse(response, payload)) {
						form.reset();
						beforeUntouched = false;
						setStatus('发布成功，等待构建', 'ok');
					} else {
						setStatus(`发布失败：${describeFailure(response, payload, '内容未写入仓库')}`, 'error');
					}
				} catch (error) {
					setStatus(`发布失败：请求没有发出去（${error.message}）`, 'error');
				} finally {
					submitBtn.disabled = false;
					submitBtn.removeAttribute('aria-busy');
					submitBtn.textContent = idleLabel;
				}
			});

			const sectionBody = (lines, headRe) => {
				const start = lines.findIndex((line) => headRe.test(line));
				if (start < 0) return null;
				let end = lines.length;
				for (let i = start + 1; i < lines.length; i++) {
					if (/^##\s/.test(lines[i])) {
						end = i;
						break;
					}
				}
				return lines.slice(start + 1, end).join('\n').trim();
			};

			// 草稿要拆成段内正文再填框：整段带 `## ` 回填会被 publish 的二级标题校验判 400
			const splitDraft = (markdown) => {
				const lines = markdown.split('\n');
				const before = sectionBody(lines, /^##\s+before\b/i);
				const after = sectionBody(lines, /^##\s+after\b/i);
				if (before === null || after === null) return null;
				return { before, after };
			};

			analyzeBtn.addEventListener('click', async () => {
				const hash = hashInput.value.trim();
				if (!hash) {
					setAnalyzeStatus('先填 Commit Hash', 'error');
					return;
				}
				if (!/^[0-9a-fA-F]{7,40}$/.test(hash)) {
					setAnalyzeStatus('Commit Hash 只允许 7-40 位十六进制字符', 'error');
					return;
				}
				if (!form.elements.password.value) {
					setAnalyzeStatus('先填 Admin Password：分析接口同样要鉴权，空密码只会白扣一次配额', 'error');
					return;
				}

				analyzeBtn.disabled = true;
				analyzeBtn.setAttribute('aria-busy', 'true');
				analyzeBtn.dataset.busy = 'true';
				setAnalyzeStatus('解析中…（读 commit 并等模型返回，最长 45 秒）', 'pending');

				try {
					const response = await fetch('/api/analyze', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ password: form.elements.password.value, commit_hash: hash }),
					});

					const { payload } = await readApiResponse(response);
					if (!isSuccessfulResponse(response, payload)) {
						setAnalyzeStatus(`解析失败：${describeFailure(response, payload)}`, 'error');
						return;
					}

					const data = payload?.data;
					const draft = data?.draft_markdown;
					if (typeof draft !== 'string' || !draft) {
						setAnalyzeStatus('解析失败：返回里没有 draft_markdown', 'error');
						return;
					}

					const parsed = splitDraft(draft);
					if (!parsed) {
						setAnalyzeStatus('草稿结构不符合预期，未自动填入，可手动粘贴', 'error');
						return;
					}

					form.elements.before.value = parsed.before;
					form.elements.after.value = parsed.after;
					beforeUntouched = true;
					const quota = data.ai ? `（今日配额 ${data.ai.quota_used_today}/${data.ai.quota_limit}）` : '';
					setAnalyzeStatus(`草稿已填入：AFTER 由 AI 生成；BEFORE 是占位，必须你本人改写后才能发布${quota}`, 'ok');
				} catch (error) {
					setAnalyzeStatus(`解析失败：请求没有发出去（${error.message}）`, 'error');
				} finally {
					analyzeBtn.disabled = false;
					analyzeBtn.removeAttribute('aria-busy');
					delete analyzeBtn.dataset.busy;
				}
			});
		</script>
	</body>
</html>
